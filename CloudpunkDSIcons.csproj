<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    	<TargetFramework>net6.0</TargetFramework>
    	<AssemblyName>bepinex.plugin.min.cloudpunkdsicons</AssemblyName>
    	<Product>DS Icons for Cloudpunk</Product>
    	<Version>1.0.0</Version>
		<Authors>min</Authors>
		<Description>BepInEx plugin for Cloudpunk (and City of Ghosts). Replaces Xbox button prompts with PlayStation button prompts.</Description>
		<Copyright>Copyright © 2026</Copyright>
    	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    	<LangVersion>latest</LangVersion>
    	<RestoreAdditionalProjectSources>
      		https://api.nuget.org/v3/index.json;
      	  	https://nuget.bepinex.dev/v3/index.json;
      	  	https://nuget.samboy.dev/v3/index.json
    	</RestoreAdditionalProjectSources>
    	<RootNamespace>CloudpunkDSIcons</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Label="UserMacros">
    	<GameDirectory>$(HOME)/Applications/Cloudpunk.app/Contents/drive_c/GOG Games</GameDirectory>
	</PropertyGroup>

	<ItemGroup>
    	<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    	<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(GameDirectory)/Cloudpunk/BepInEx/interop/Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(GameDirectory)/Cloudpunk/BepInEx/interop/UnityEngine.dll</HintPath>
		</Reference>
    	<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GameDirectory)/Cloudpunk/BepInEx/interop/UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(GameDirectory)/Cloudpunk/BepInEx/interop/UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="resources/controller_layout_Xbox_modified.png" />
		<EmbeddedResource Include="resources/itematlas_volaris_modified.png" />
	</ItemGroup>

</Project>
